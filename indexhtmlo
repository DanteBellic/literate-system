    }
    if(q.includes('ترتیب') && q.includes('devil')){
      return 'اگر هدفت دنبال کردن خط داستانی است، می‌توانیم ترتیب داستانی یا ترتیب انتشار را جداگانه برایت توضیح بدهیم.';
    }
    return 'این بخش فعلاً در حالت نمایشی است. رابط DARKINO AI آماده شده، اما برای اینکه سؤال‌های آزاد را واقعاً با هوش مصنوعی پاسخ بدهد باید آدرس Cloudflare Worker را به سایت وصل کنیم.';
  }

  async function askAI(){
    const question=aiInput.value.trim();
    if(!question || aiSend.disabled)return;
    addAiMessage(question,'user');
    aiInput.value='';
    aiSend.disabled=true;
    aiStatus.textContent='در حال فکر کردن…';

    try{
      if(!AI_WORKER_URL){
        await new Promise(r=>setTimeout(r,450));
        addAiMessage(localDemoAnswer(question),'ai','پاسخ نمایشی DARKINO AI');
      }else{
        const response=await fetch(AI_WORKER_URL,{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({message:question})
        });
        const rawText = await response.text();
        let data = {};
        try { data = JSON.parse(rawText); } catch { data = { raw: rawText }; }

        if(!response.ok){
          const detail = data.details || data.error || data.raw || 'بدون جزئیات';
          throw new Error('Worker ' + response.status + ': ' + detail);
        }

        if(!data.answer){
          throw new Error(data.error || 'پاسخ AI خالی است.');
        }

        addAiMessage(data.answer,'ai','DARKINO AI');
      }
      aiStatus.textContent=AI_WORKER_URL?'متصل به AI':'حالت نمایشی — Worker هنوز تنظیم نشده';
    }catch(err){
      console.error('DARKINO AI error:', err);
      const detail = err?.message || 'خطای نامشخص';
      addAiMessage('اتصال AI برقرار نشد. جزئیات: ' + detail,'ai','خطای اتصال');
      aiStatus.textContent='خطا در اتصال';
    }finally{
      aiSend.disabled=false;
      aiInput.focus();
    }
  }

  aiLaunch?.addEventListener('click',()=>{aiPanel.classList.toggle('open');if(aiPanel.classList.contains('open'))aiInput.focus()});
  aiClose?.addEventListener('click',()=>aiPanel.classList.remove('open'));
  aiSend?.addEventListener('click',askAI);
  aiInput?.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();askAI()}});
  $$('.ai-quick button').forEach(b=>b.addEventListener('click',()=>{aiInput.value=b.dataset.aiQ;askAI()}));

$('#footYear').textContent=new Date().getFullYear();
})();
</script>

