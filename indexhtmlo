<meta name="twitter:title" content="Darkino Gaming — راهنمای باس‌فایت‌ها و تجهیزات گیمینگ">
<meta name="twitter:description" content="راهنمای عبور از سخت‌ترین باس‌فایت‌ها و مراحل بازی، تاکتیک‌های تخصصی و پیشنهاد تجهیزات گیمینگ.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Vazirmatn:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#0c0a10;
    --void-2:#141018;
    --panel:#19141f;
    --ember:#c1442d;
    --ember-dim:#7a2d21;
    --torch:#e3a857;
    --bone:#e9e2d6;
    --ash:#8b8378;
    --line:#2c2531;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(193,68,45,0.14), transparent),
      radial-gradient(ellipse 60% 40% at 90% 10%, rgba(227,168,87,0.06), transparent),
      var(--void);
    color:var(--bone);
    font-family:'Vazirmatn',sans-serif;
    line-height:1.7;
  }
  .mono{font-family:'JetBrains Mono',monospace;direction:ltr;display:inline-block;}
  .display{font-family:'Cinzel','Vazirmatn',serif;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  ::selection{background:var(--ember);color:var(--void);}
  :focus-visible{outline:2px solid var(--torch);outline-offset:3px;}

  .wrap{max-width:1180px;margin:0 auto;padding:0 28px;}

  /* ---------- NAV ---------- */
  header.site{
    position:sticky;top:0;z-index:50;
    background:rgba(12,10,16,0.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;max-width:1180px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:10px;}
  .brand .mark{
    width:34px;height:34px;border:1.5px solid var(--ember);
    display:flex;align-items:center;justify-content:center;
    transform:rotate(45deg);
    color:var(--torch);font-size:14px;
  }
  .brand .mark span{transform:rotate(-45deg);}
  .brand .word{font-family:'Cinzel',serif;font-weight:900;font-size:20px;letter-spacing:0.14em;direction:ltr;color:var(--bone);}
  .brand .word em{font-style:normal;color:var(--ember);}
  nav.links{display:flex;gap:32px;font-size:14.5px;color:var(--ash);}
  nav.links a{position:relative;padding:4px 0;transition:color .2s;}
  nav.links a:hover{color:var(--bone);}
  nav.links a::after{content:"";position:absolute;bottom:-2px;right:0;width:0;height:1px;background:var(--ember);transition:width .25s;}
  nav.links a:hover::after{width:100%;}
  .cta-btn{
    border:1px solid var(--ember-dim);
    color:var(--torch);
    padding:8px 18px;
    font-size:13.5px;
    background:linear-gradient(180deg, rgba(193,68,45,0.12), transparent);
    transition:all .2s;
    white-space:nowrap;
  }
  .cta-btn:hover{border-color:var(--ember);background:rgba(193,68,45,0.22);}

  /* ---------- HERO ---------- */
  .hero{padding:96px 28px 64px;text-align:center;position:relative;overflow:hidden;}
  .hero::before{
    content:"";position:absolute;inset:0;
    background-image:
      linear-gradient(rgba(233,226,214,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(233,226,214,0.025) 1px, transparent 1px);
    background-size:42px 42px;
    mask-image:radial-gradient(ellipse 70% 60% at 50% 20%, black, transparent);
    pointer-events:none;
  }
  .eyebrow{
    font-family:'JetBrains Mono',monospace;direction:ltr;
    font-size:12px;letter-spacing:0.25em;color:var(--torch);
    display:inline-flex;align-items:center;gap:10px;margin-bottom:26px;
    opacity:0;animation:fadeUp .7s .1s ease forwards;
  }
  .eyebrow::before,.eyebrow::after{content:"";width:26px;height:1px;background:var(--ember-dim);}
  h1.wordmark{
    font-family:'Cinzel',serif;font-weight:900;
    font-size:clamp(52px,11vw,124px);
    letter-spacing:0.05em;
    direction:ltr;
    line-height:0.95;
    background:linear-gradient(180deg,#f3ece0 0%, var(--bone) 45%, var(--ash) 100%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:0 0 60px rgba(193,68,45,0.25);
    opacity:0;animation:fadeUp .8s .2s ease forwards;
  }
  .wordmark .accent-dot{color:var(--ember);-webkit-text-fill-color:var(--ember);}
  .tagline{
    max-width:560px;margin:22px auto 0;
    font-size:17px;color:var(--ash);
    opacity:0;animation:fadeUp .8s .35s ease forwards;
  }
  .tagline strong{color:var(--bone);font-weight:600;}
  @keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}

  /* difficulty selector */
  .tiers{
    display:flex;justify-content:center;gap:10px;flex-wrap:wrap;
    margin-top:44px;
    opacity:0;animation:fadeUp .8s .5s ease forwards;
  }
  .tier{
    font-family:'JetBrains Mono',monospace;direction:ltr;font-size:12.5px;letter-spacing:0.05em;
    padding:10px 18px;border:1px solid var(--line);
    color:var(--ash);cursor:pointer;background:var(--panel);
    transition:all .2s;position:relative;
  }
  .tier b{color:inherit;font-weight:600;}
  .tier[data-tier="1"]{--tc:#7fae6a;}
  .tier[data-tier="2"]{--tc:var(--torch);}
  .tier[data-tier="3"]{--tc:#d16a3f;}
  .tier[data-tier="4"]{--tc:var(--ember);}
  .tier:hover{color:var(--bone);border-color:var(--ash);}
  .tier.active{color:var(--tc);border-color:var(--tc);background:rgba(233,226,214,0.04);}
  .tier.active::before{
    content:"";position:absolute;right:-1px;bottom:-1px;left:-1px;height:2px;background:var(--tc);
  }

  /* ---------- SECTION HEADS ---------- */
  section{padding:78px 28px;}
  .sec-head{max-width:1180px;margin:0 auto 40px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:20px;}
  .sec-head .tag{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:12px;letter-spacing:0.2em;color:var(--ember);margin-bottom:8px;display:block;}
  .sec-head h2{font-family:'Cinzel',serif;font-weight:700;font-size:clamp(26px,3.6vw,36px);}
  .sec-head p{color:var(--ash);font-size:14.5px;max-width:360px;}

  /* ---------- LEDGER (boss guide cards) ---------- */
  .ledger{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .entry{
    background:var(--panel);border:1px solid var(--line);
    position:relative;transition:transform .25s, border-color .25s, box-shadow .25s;
  }
  .entry:hover{transform:translateY(-4px);border-color:var(--ember-dim);box-shadow:0 18px 40px -20px rgba(193,68,45,0.4);}
  .entry-top{padding:20px 20px 16px;border-bottom:1px dashed var(--line);display:flex;justify-content:space-between;gap:12px;}
  .entry-game{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11px;color:var(--ash);letter-spacing:0.08em;text-transform:uppercase;}
  .entry-boss{font-family:'Cinzel',serif;font-weight:700;font-size:19px;margin-top:6px;color:var(--bone);}
  .seal{
    flex-shrink:0;width:52px;height:52px;border:1.5px solid var(--tc,var(--ember));
    border-radius:50%;display:flex;align-items:center;justify-content:center;
    transform:rotate(-12deg);color:var(--tc,var(--ember));
    font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:600;text-align:center;line-height:1.2;
    direction:ltr;
  }
  .entry-body{padding:18px 20px 22px;}
  .meter{height:5px;background:var(--void-2);display:flex;gap:2px;margin-bottom:16px;}
  .meter i{flex:1;background:var(--line);}
  .meter i.on{background:var(--tc,var(--ember));}
  .entry-body p{font-size:14px;color:var(--ash);margin-bottom:16px;}
  .entry-tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;}
  .entry-tags span{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:10.5px;color:var(--torch);border:1px solid var(--ember-dim);padding:3px 9px;}
  .entry-link{font-size:13.5px;color:var(--bone);display:inline-flex;align-items:center;gap:8px;border-top:1px solid var(--line);padding-top:14px;width:100%;}
  .entry-link .arrow{transition:transform .2s;color:var(--ember);}
  .entry:hover .entry-link .arrow{transform:translateX(-5px);}

  /* ---------- LOADOUT (gear) ---------- */
  .loadout-wrap{background:var(--void-2);}
  .loadout{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);}
  .slot{background:var(--void);padding:26px 22px;transition:background .2s;}
  .slot:hover{background:var(--panel);}
  .slot .slot-id{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11px;color:var(--ember);margin-bottom:14px;}
  .slot h3{font-family:'Cinzel',serif;font-size:17px;margin-bottom:6px;}
  .slot .item{font-size:13.5px;color:var(--torch);margin-bottom:10px;}
  .slot p{font-size:13px;color:var(--ash);}

  /* ---------- DISPATCH (latest guides list) ---------- */
  .dispatch{max-width:820px;margin:0 auto;}
  .row{
    display:flex;align-items:center;justify-content:space-between;gap:20px;
    padding:20px 4px;border-bottom:1px solid var(--line);cursor:pointer;transition:background .2s, padding-right .2s;
  }
  .row:hover{background:rgba(233,226,214,0.02);padding-right:10px;}
  .row:first-child{border-top:1px solid var(--line);}
  .row-l{display:flex;align-items:baseline;gap:18px;}
  .row-num{font-family:'JetBrains Mono',monospace;direction:ltr;color:var(--ember-dim);font-size:13px;}
  .row-title{font-size:15.5px;color:var(--bone);}
  .row-title span{color:var(--ash);font-size:13px;display:block;margin-top:3px;}
  .row-meta{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:12px;color:var(--ash);white-space:nowrap;}

  /* ---------- FOOTER ---------- */
  footer{border-top:1px solid var(--line);padding:44px 28px;}
  .foot-wrap{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
  footer .word{font-family:'Cinzel',serif;font-weight:900;font-size:16px;letter-spacing:0.1em;direction:ltr;color:var(--ash);}
  footer .word em{color:var(--ember);font-style:normal;}
  footer p{font-size:13px;color:var(--ash);}

  @media (max-width:860px){
    nav.links{display:none;}
    .ledger{grid-template-columns:1fr;}
    .loadout{grid-template-columns:repeat(2,1fr);}
  }
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important;transition-duration:0.01ms !important;}
  }

  /* ---------- SEARCH ---------- */
  .search-wrap{position:relative;}
  .search-btn{
    width:38px;height:38px;border:1px solid var(--line);background:var(--panel);color:var(--ash);
    display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;flex-shrink:0;
  }
  .search-btn:hover{color:var(--bone);border-color:var(--ash);}
  .search-panel{
    position:fixed;inset:0;background:rgba(12,10,16,0.92);backdrop-filter:blur(6px);
    z-index:200;display:none;padding:80px 20px 20px;
  }
  .search-panel.open{display:block;}
  .search-box{max-width:640px;margin:0 auto;}
  .search-input-row{display:flex;gap:10px;align-items:center;border:1px solid var(--ember-dim);background:var(--panel);padding:12px 16px;}
  .search-input-row input{
    flex:1;background:transparent;border:none;outline:none;color:var(--bone);font-family:'Vazirmatn',sans-serif;font-size:16px;
  }
  .search-input-row input::placeholder{color:var(--ash);}
  .search-close{background:none;border:none;color:var(--ash);font-size:22px;cursor:pointer;line-height:1;}
  .search-results{max-width:640px;margin:14px auto 0;max-height:65vh;overflow-y:auto;}
  .search-result{
    display:flex;justify-content:space-between;align-items:center;gap:12px;
    padding:14px 16px;border:1px solid var(--line);background:var(--panel);margin-bottom:8px;cursor:pointer;transition:border-color .2s;
  }
  .search-result:hover{border-color:var(--torch);}
  .search-result .sr-title{font-size:14px;color:var(--bone);}
  .search-result .sr-sub{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11px;color:var(--ash);margin-top:4px;}
  .search-result .sr-tag{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:10px;color:var(--torch);white-space:nowrap;}
  .search-empty{color:var(--ash);font-size:13.5px;text-align:center;padding:30px 0;}

  /* ---------- GAME FILTER ---------- */
  .game-filter{max-width:1180px;margin:0 auto 28px;padding:0 28px;display:flex;gap:8px;flex-wrap:wrap;}
  .gf{
    font-family:'Vazirmatn',sans-serif;font-size:12.5px;padding:8px 16px;border:1px solid var(--line);
    color:var(--ash);background:var(--panel);cursor:pointer;transition:all .2s;
  }
  .gf:hover{color:var(--bone);border-color:var(--ash);}
  .gf.active{color:var(--torch);border-color:var(--ember-dim);background:rgba(227,168,87,0.06);}
  .sort-wrap{display:flex;align-items:center;gap:8px;margin-right:auto;font-size:12.5px;color:var(--ash);}
  .sort-wrap select{
    background:var(--panel);border:1px solid var(--line);color:var(--bone);
    font-family:'Vazirmatn',sans-serif;font-size:12.5px;padding:7px 10px;cursor:pointer;
  }
  @media (max-width:860px){ .sort-wrap{margin-right:0;width:100%;} }

  .badge-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
  .badge-verified{
    display:inline-flex;align-items:center;gap:5px;font-family:'JetBrains Mono',monospace;direction:ltr;
    font-size:10.5px;color:#7fae6a;border:1px solid #3a4d33;padding:4px 9px;background:rgba(127,174,106,0.06);
  }
  .badge-spoiler{
    display:inline-flex;align-items:center;gap:5px;font-family:'JetBrains Mono',monospace;direction:ltr;
    font-size:10.5px;padding:4px 9px;border:1px solid var(--ember-dim);color:var(--torch);background:rgba(227,168,87,0.06);
  }
  .quickstats{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:20px;}
  .qs-cell{background:var(--void);padding:10px 14px;}
  .qs-cell .qs-label{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:10px;color:var(--ash);margin-bottom:3px;}
  .qs-cell .qs-val{font-size:13px;color:var(--bone);}
  .modal-section-title{
    font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11px;letter-spacing:0.1em;
    color:var(--ember);margin:20px 0 8px;padding-top:16px;border-top:1px dashed var(--line);
  }
  .modal-section-title:first-of-type{border-top:none;padding-top:0;margin-top:0;}
  .modal-list{list-style:none;padding:0;margin:0;}
  .modal-list li{font-size:13.5px;color:var(--ash);line-height:1.9;padding-right:16px;position:relative;}
  .modal-list li::before{content:"•";position:absolute;right:0;color:var(--ember);}
  .modal-mistakes li::before{content:"✕";color:#c1442d;font-size:11px;}
  .modal-related{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
  .modal-related button{
    text-align:right;background:var(--void-2);border:1px solid var(--line);color:var(--bone);
    font-family:'Vazirmatn',sans-serif;font-size:13px;padding:10px 14px;cursor:pointer;transition:border-color .2s;
  }
  .modal-related button:hover{border-color:var(--ember-dim);}
  .ledger-empty{max-width:1180px;margin:0 auto 20px;padding:0 28px;color:var(--ash);font-size:13.5px;}
  .entry[hidden]{display:none;}

  /* ---------- GUIDE MODAL ---------- */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(12,10,16,0.88);backdrop-filter:blur(4px);
    z-index:300;display:none;align-items:center;justify-content:center;padding:20px;
  }
  .modal-overlay.open{display:flex;}
  .modal-box{
    max-width:560px;width:100%;max-height:82vh;overflow-y:auto;
    background:var(--panel);border:1px solid var(--ember-dim);padding:28px 26px;position:relative;
  }
  .modal-close{position:absolute;top:16px;left:16px;background:none;border:none;color:var(--ash);font-size:22px;cursor:pointer;line-height:1;}
  .modal-close:hover{color:var(--bone);}
  .modal-game{font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11px;color:var(--ember);letter-spacing:0.08em;margin-bottom:8px;}
  .modal-title{font-family:'Cinzel',serif;font-weight:700;font-size:22px;margin-bottom:18px;}
  .modal-body{font-size:14px;color:var(--ash);line-height:2;}

  /* ---------- MOBILE BOTTOM NAV ---------- */
  .mobile-nav{display:none;}
  @media (max-width:860px){
    .mobile-nav{
      display:flex;position:fixed;bottom:0;right:0;left:0;z-index:100;
      background:rgba(12,10,16,0.96);backdrop-filter:blur(10px);border-top:1px solid var(--line);
      padding:8px 4px calc(8px + env(safe-area-inset-bottom));
    }
    .mobile-nav a,.mobile-nav button{
      flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
      color:var(--ash);font-size:10.5px;padding:6px 2px;transition:color .2s;
      background:none;border:none;font-family:'Vazirmatn',sans-serif;cursor:pointer;
    }
    .mobile-nav a .mn-ic,.mobile-nav button .mn-ic{font-size:17px;}
    .mobile-nav a.active,.mobile-nav a:hover,.mobile-nav button:hover{color:var(--torch);}
    body{padding-bottom:64px;}
  }

  /* ---------- DMC3 VAULT ---------- */
  :root{ --cobalt:#3d6ef0; --cobalt-dim:#22335c; --cobalt-glow:rgba(61,110,240,0.18); }
  .vault-wrap{
    background:
      radial-gradient(ellipse 60% 40% at 15% 0%, var(--cobalt-glow), transparent),
      var(--void-2);
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .vault-head{max-width:1180px;margin:0 auto 8px;padding:0 28px;}
  .vault-badge{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11.5px;letter-spacing:0.2em;
    color:var(--cobalt);border:1px solid var(--cobalt-dim);padding:5px 12px;margin-bottom:18px;
    background:rgba(61,110,240,0.06);
  }
  .vault-badge::before{content:"";width:6px;height:6px;background:var(--cobalt);border-radius:50%;box-shadow:0 0 8px var(--cobalt);}
  .vault-head h2{font-family:'Cinzel',serif;font-weight:700;font-size:clamp(26px,3.8vw,38px);margin-bottom:10px;}
  .vault-head h2 .sub{display:block;font-size:14px;font-weight:500;color:var(--ash);font-family:'Vazirmatn',sans-serif;margin-top:8px;}
  .vault-head p.copy{color:var(--ash);font-size:14.5px;max-width:560px;line-height:1.8;}
  .vault-copyright-note{
    font-family:'JetBrains Mono',monospace;direction:ltr;font-size:11px;color:var(--ash);
    border-right:2px solid var(--cobalt-dim);padding-right:12px;margin-top:16px;line-height:1.7;max-width:560px;
  }

  .vault-grid{
    max-width:1180px;margin:36px auto 0;padding:0 28px 70px;
    display:grid;grid-template-columns:repeat(4,1fr);gap:12px;
  }
  details.mcard{
    background:var(--panel);border:1px solid var(--line);
    transition:border-color .2s;
  }
  details.mcard[open]{border-color:var(--cobalt-dim);}
  details.mcard summary{
